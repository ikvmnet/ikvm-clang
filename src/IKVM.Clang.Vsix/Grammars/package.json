{
    "name": "ikvm-clang",
    "displayName": "IKVM.Clang Language Support",
    "description": "TextMate grammars for the files of IKVM.Clang projects that Visual Studio's own grammars do not cover. C, C++, Objective-C and Objective-C++ use Visual Studio's built-in grammars.",
    "version": "1.0.0",
    "engines": { "vscode": "*" },
    "contributes": {
        "grammars": [
            {
                "language": "cpp-extra",
                "scopeName": "source.cpp.ikvm-clang",
                "path": "./cpp-extra.tmLanguage.json"
            },
            {
                "language": "asm",
                "scopeName": "source.asm.gas",
                "path": "./asm.tmLanguage.json"
            }
        ],
        "languages": [
            {
                "id": "cpp-extra",
                "aliases": [ "C++" ],
                "extensions": [ ".cppm", ".ixx", ".hxx", ".ipp" ]
            },
            {
                "id": "asm",
                "aliases": [ "Assembly", "asm" ],
                "extensions": [ ".s", ".S", ".asm" ]
            }
        ]
    }
}
