<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<Nullable>enable</Nullable>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<PropertyGroup>
		<VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
		<VsixDeployOnDebug>true</VsixDeployOnDebug>
		<GeneratePkgDefFile>true</GeneratePkgDefFile>

		<IsManagedProjectSystemProject>true</IsManagedProjectSystemProject>
		<CreateVsixContainer>True</CreateVsixContainer>
		<TargetVsixContainerName>IKVM.Clang.vsix</TargetVsixContainerName>
		<IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
		<IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
		<IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
		<DeployExtension Condition=" '$(BuildingInsideVisualStudio)' != 'true' ">false</DeployExtension>
		<Experimental>false</Experimental>
		<Experimental Condition=" '$(BuildingInsideVisualStudio)' == 'true' ">true</Experimental>
	</PropertyGroup>

	<ItemGroup>
		<TransformValues Include="PackageVersion">
			<Value>$(PackageVersion)</Value>
		</TransformValues>
		<TransformValues Include="NuGetPath">
			<Value>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(OutputPath)\nuget'))</Value>
		</TransformValues>
	</ItemGroup>

	<ItemGroup>
		<None Remove="IKVM.Clang.imagemanifest" />
		<None Remove="IKVM.Clang.manifest.json" />
		<None Remove="Images\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
		<PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.VisualStudio.ProjectSystem.SDK" Version="17.9.380" ExcludeAssets="runtime" />
		<PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" ExcludeAssets="runtime" />
		<PackageReference Include="Microsoft.VisualStudio.ProjectSystem.Sdk.Tools" Version="17.9.380">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="System.ComponentModel.Composition" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="VSPackage.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>VSPackage.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="VSPackage.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>VSPackage.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="IKVM.Clang.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Content Include="Grammars\package.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
			<VSIXSubPath>Grammars</VSIXSubPath>
		</Content>
		<Content Include="Grammars\cpp-extra.tmLanguage.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
			<VSIXSubPath>Grammars</VSIXSubPath>
		</Content>
		<Content Include="Grammars\asm.tmLanguage.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
			<VSIXSubPath>Grammars</VSIXSubPath>
		</Content>
		<Content Include="IKVM.Clang.imagemanifest">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="IKVM.Clang.manifest.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Images\ClangProjectIcon_128x.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="..\..\LICENSE">
			<Link>LICENSE</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Resource Include="Images\ClangProjectIcon_16x.png" />
		<Resource Include="Images\ClangProjectIcon_24x.png" />
		<Resource Include="Images\ClangProjectIcon_32x.png" />
		<Resource Include="Images\ClangProjectIcon_128x.png" />
		<Resource Include="Images\ClangProjectIcon_256x.png" />
		<EmbeddedResource Include="Images\ClangProjectIcon.ico" />
	</ItemGroup>

	<ItemGroup>
		<Transform Include="..\IKVM.Clang.Templates\content\**\*.in">
			<TargetPath>$(IntermediateOutputPath)ProjectTemplates\%(RecursiveDir)%(Filename)</TargetPath>
		</Transform>
	</ItemGroup>

	<!-- start from an empty folder so templates or files removed from the source do not linger in the VSIX -->
	<Target Name="CleanVsixTemplateFiles" BeforeTargets="Transform">
		<RemoveDir Directories="$(IntermediateOutputPath)ProjectTemplates" />
	</Target>

	<Target Name="CopyVsixTemplateFiles" DependsOnTargets="Transform" BeforeTargets="PrepareForBuild">
		<ItemGroup>
			<_SourceFiles Include="ProjectTemplates\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(_SourceFiles)" DestinationFolder="$(IntermediateOutputPath)ProjectTemplates\%(RecursiveDir)" />
		<ItemGroup>
			<_VSTemplateSourceFiles Include="ProjectTemplates\**\*.vstemplate" />
		</ItemGroup>
		<Copy SourceFiles="Images\ClangProjectIcon_32x.png" DestinationFolder="$(IntermediateOutputPath)ProjectTemplates\%(_VSTemplateSourceFiles.RecursiveDir)" />
		<ItemGroup>
			<_LinkedSourceFiles Include="..\IKVM.Clang.Templates\content\**\*" Exclude="..\IKVM.Clang.Templates\content\**\*.in;..\IKVM.Clang.Templates\content\**\template.json;..\IKVM.Clang.Templates\content\**\.template.config\**" />
		</ItemGroup>
		<Copy SourceFiles="@(_LinkedSourceFiles)" DestinationFiles="@(_LinkedSourceFiles->'$(IntermediateOutputPath)ProjectTemplates\%(RecursiveDir)%(Filename)%(Extension)')">
			<Output TaskParameter="CopiedFiles" ItemName="_CopiedVsixSourceFiles" />
		</Copy>
	</Target>

	<Target Name="IncludeVsixTransformedFiles" DependsOnTargets="CopyVsixTemplateFiles" BeforeTargets="PrepareForBuild;GetVsixSourceItems">
		<ItemGroup>
			<VSTemplate Include="$(IntermediateOutputPath)ProjectTemplates\**\*.vstemplate">
				<SubType>Designer</SubType>
			</VSTemplate>
			<_ProjectTemplatesItems Include="$(IntermediateOutputPath)ProjectTemplates\**\*" />
			<Content Include="@(_ProjectTemplatesItems)">
				<VSIXSubPath>ProjectTemplates\%(RecursiveDir)</VSIXSubPath>
				<IncludeInVSIX>true</IncludeInVSIX>
			</Content>
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageProjectReference Include="..\IKVM.Clang.Sdk\IKVM.Clang.Sdk.csproj">
			<PackageTargetPath>nuget</PackageTargetPath>
		</PackageProjectReference>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\IKVM.Clang.Sdk.Tests\Project\**" Exclude="..\IKVM.Clang.Sdk.Tests\Project\global.json;..\IKVM.Clang.Sdk.Tests\Project\nuget.config;..\IKVM.Clang.Sdk.Tests\Project\**\bin\**;..\IKVM.Clang.Sdk.Tests\Project\**\obj\**;..\IKVM.Clang.Sdk.Tests\Project\.vs\**">
			<Link>TestProject\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<Transform Include="TestProject\**\*.in">
			<TargetPath>$(IntermediateOutputPath)TestProject\%(RecursiveDir)%(Filename)</TargetPath>
		</Transform>
	</ItemGroup>

	<Target Name="IncludeTestProjectTransformedFiles" DependsOnTargets="Transform" BeforeTargets="PrepareForBuild">
		<ItemGroup>
			<_TestProjectTemplatesItems Include="$(IntermediateOutputPath)TestProject\**\*" />
			<None Include="@(_TestProjectTemplatesItems)">
				<TargetPath>TestProject\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</None>
		</ItemGroup>
	</Target>

	<Target Name="GetVsixVersion" Returns="$(FileVersion)" />
	<Target Name="GetVsixExperimental" Returns="$(Experimental)" />
</Project>
