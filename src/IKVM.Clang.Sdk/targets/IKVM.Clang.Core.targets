<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    </PropertyGroup>

    <!--
    LLVM tools. ResolveLlvmToolset finds them; these properties control where:

      LlvmToolsPath   a directory to take every tool from, such as the bin directory of an LLVM installation
      ClangPath       full path of clang
      ClangCxxPath    full path of clang++, which links projects with C++ or Objective-C++ sources
      LlvmArPath      full path of llvm-ar, which creates static libraries
      ClangdPath      full path of clangd, which Visual Studio runs for language support
      LinkerPath      full path of the linker for clang to run (its ld-path option); otherwise clang finds lld next to it

    A tool not given by full path comes from LlvmToolsPath, or else from the LLVM installation clang is found in, so
    that the tools match. ClangToolPath with ClangToolExe, and LlvmArToolPath with LlvmArToolExe, are still honoured.
    -->
    <PropertyGroup>
        <ClangToolName Condition=" '$(ClangToolName)' == '' And !$([MSBuild]::IsOSUnixLike())">clang.exe</ClangToolName>
        <ClangToolName Condition=" '$(ClangToolName)' == '' And  $([MSBuild]::IsOSUnixLike())">clang</ClangToolName>
        <ClangToolExe Condition=" '$(ClangToolExe)' == '' And '$(ClangToolName)' != '' ">$(ClangToolName)</ClangToolExe>
        <ClangCxxToolName Condition=" '$(ClangCxxToolName)' == '' And !$([MSBuild]::IsOSUnixLike())">clang++.exe</ClangCxxToolName>
        <ClangCxxToolName Condition=" '$(ClangCxxToolName)' == '' And  $([MSBuild]::IsOSUnixLike())">clang++</ClangCxxToolName>
        <LlvmArToolName Condition=" '$(LlvmArToolName)' == '' And !$([MSBuild]::IsOSUnixLike())">llvm-ar.exe</LlvmArToolName>
        <LlvmArToolName Condition=" '$(LlvmArToolName)' == '' And  $([MSBuild]::IsOSUnixLike())">llvm-ar</LlvmArToolName>
        <LlvmArToolExe Condition=" '$(LlvmArToolExe)' == '' And '$(LlvmArToolName)' != '' ">$(LlvmArToolName)</LlvmArToolExe>
        <ClangdToolName Condition=" '$(ClangdToolName)' == '' And !$([MSBuild]::IsOSUnixLike())">clangd.exe</ClangdToolName>
        <ClangdToolName Condition=" '$(ClangdToolName)' == '' And  $([MSBuild]::IsOSUnixLike())">clangd</ClangdToolName>

        <!-- the older ToolPath (a directory) and ToolExe (a file name, or a full path) pairs -->
        <ClangPath Condition=" '$(ClangPath)' == '' And '$(ClangToolPath)' != '' ">$([System.IO.Path]::Combine('$(ClangToolPath)', '$(ClangToolExe)'))</ClangPath>
        <ClangPath Condition=" '$(ClangPath)' == '' And $([System.IO.Path]::IsPathRooted('$(ClangToolExe)')) ">$(ClangToolExe)</ClangPath>
        <LlvmArPath Condition=" '$(LlvmArPath)' == '' And '$(LlvmArToolPath)' != '' ">$([System.IO.Path]::Combine('$(LlvmArToolPath)', '$(LlvmArToolExe)'))</LlvmArPath>
        <LlvmArPath Condition=" '$(LlvmArPath)' == '' And $([System.IO.Path]::IsPathRooted('$(LlvmArToolExe)')) ">$(LlvmArToolExe)</LlvmArPath>
    </PropertyGroup>

    <PropertyGroup>
        <TargetName Condition=" '$(TargetName)' == '' ">$(MSBuildProjectName)</TargetName>
        <OutputType Condition=" '$(OutputType)' == '' ">Dll</OutputType>
        <TargetTriple Condition=" '$(TargetTriple)' == '' ">$(TargetIdentifier)</TargetTriple>
        <DebugSymbols Condition=" '$(DebugSymbols)' == '' And '$(Configuration)' == 'Debug' ">true</DebugSymbols>
        <!-- passed as -O<level>: 0, 1, 2, 3, s, z or g; empty leaves it to clang, which does not optimize -->
        <Optimization Condition=" '$(Optimization)' == '' And '$(Configuration)' == 'Release' ">2</Optimization>
        <!-- false defines NDEBUG, which removes assert -->
        <Assertions Condition=" '$(Assertions)' == '' And '$(Configuration)' == 'Release' ">false</Assertions>
    </PropertyGroup>

    <!--
    ClangTargetOS names the kind of platform being built for, which decides output file names: windows, apple, wasm,
    or unix for Linux and other ELF platforms. It comes from TargetTriple, or, when there is none and clang builds for
    the host, from the host. ClangTargetIsMsvc says whether the MSVC environment is targeted, which is when the linker
    writes a separate .pdb.
    -->
    <PropertyGroup>
        <_ClangTriple>$(TargetTriple.ToLowerInvariant())</_ClangTriple>
        <ClangTargetOS Condition=" '$(ClangTargetOS)' == '' And '$(_ClangTriple)' != '' And $(_ClangTriple.StartsWith('wasm')) ">wasm</ClangTargetOS>
        <ClangTargetOS Condition=" '$(ClangTargetOS)' == '' And '$(_ClangTriple)' != '' And ($(_ClangTriple.Contains('-windows')) Or $(_ClangTriple.Contains('mingw')) Or $(_ClangTriple.Contains('cygwin')) Or $(_ClangTriple.Contains('-win32'))) ">windows</ClangTargetOS>
        <ClangTargetOS Condition=" '$(ClangTargetOS)' == '' And '$(_ClangTriple)' != '' And ($(_ClangTriple.Contains('-apple')) Or $(_ClangTriple.Contains('darwin')) Or $(_ClangTriple.Contains('-macos')) Or $(_ClangTriple.Contains('-ios'))) ">apple</ClangTargetOS>
        <ClangTargetOS Condition=" '$(ClangTargetOS)' == '' And '$(_ClangTriple)' != '' ">unix</ClangTargetOS>
        <ClangTargetOS Condition=" '$(ClangTargetOS)' == '' And $([MSBuild]::IsOSPlatform('Windows')) ">windows</ClangTargetOS>
        <ClangTargetOS Condition=" '$(ClangTargetOS)' == '' And $([MSBuild]::IsOSPlatform('OSX')) ">apple</ClangTargetOS>
        <ClangTargetOS Condition=" '$(ClangTargetOS)' == '' ">unix</ClangTargetOS>
        <ClangTargetIsMsvc Condition=" '$(ClangTargetIsMsvc)' == '' And '$(_ClangTriple)' != '' And $(_ClangTriple.Contains('-msvc')) ">true</ClangTargetIsMsvc>
        <ClangTargetIsMsvc Condition=" '$(ClangTargetIsMsvc)' == '' And '$(_ClangTriple)' == '' And $([MSBuild]::IsOSPlatform('Windows')) ">true</ClangTargetIsMsvc>
        <ClangTargetIsMsvc Condition=" '$(ClangTargetIsMsvc)' == '' ">false</ClangTargetIsMsvc>
    </PropertyGroup>

    <!--
    Code for ELF platforms is position independent, so that a static library can be linked into a shared one. Windows
    does not take -fPIC, Apple platforms always build position independent code, and on WebAssembly it selects dynamic
    linking.
    -->
    <PropertyGroup>
        <PositionIndependentCode Condition=" '$(PositionIndependentCode)' == '' And '$(ClangTargetOS)' == 'unix' ">true</PositionIndependentCode>
    </PropertyGroup>

    <!-- only the MSVC environment's linker writes debug information to its own file; elsewhere it is in the binary -->
    <PropertyGroup Condition=" '$(ClangTargetIsMsvc)' == 'true' And ('$(OutputType)' == 'exe' Or '$(OutputType)' == 'dll') ">
        <DebugSymbolsExt Condition=" '$(DebugSymbolsExt)' == '' ">.pdb</DebugSymbolsExt>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(OutputType)' == 'exe' ">
        <ExecutablePrefix Condition=" '$(ExecutablePrefix)' == '' "></ExecutablePrefix>
        <ExecutableExt Condition=" '$(ExecutableExt)' == '' "></ExecutableExt>
        <ExecutableExt Condition=" '$(ExecutableExt)' == '' And '$(ClangTargetOS)' == 'windows'">.exe</ExecutableExt>
        <ExecutableExt Condition=" '$(ExecutableExt)' == '' And '$(ClangTargetOS)' == 'unix'"></ExecutableExt>
        <ExecutableExt Condition=" '$(ExecutableExt)' == '' And '$(ClangTargetOS)' == 'apple'"></ExecutableExt>
        <ExecutableExt Condition=" '$(ExecutableExt)' == '' And '$(ClangTargetOS)' == 'wasm'">.wasm</ExecutableExt>
        <ExecutableFileName Condition=" '$(ExecutableFileName)' == '' ">$(ExecutablePrefix)$(TargetName)$(ExecutableExt)</ExecutableFileName>
        <ExecutableIntermediateOutputPath Condition=" '$(ExecutableFileName)' != '' ">$(IntermediateOutputPath)$(ExecutableFileName)</ExecutableIntermediateOutputPath>
        <DebugSymbolsPrefix Condition=" '$(DebugSymbolsPrefix)' == '' "></DebugSymbolsPrefix>
        <CopyProjectReferenceOutputToOutput Condition=" '$(CopyProjectReferenceOutputToOutput)' == '' ">true</CopyProjectReferenceOutputToOutput>
        <UseLd Condition=" '$(UseLd)' == '' ">lld</UseLd>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(OutputType)' == 'dll' ">
        <ExecutablePrefix Condition=" '$(ExecutablePrefix)' == '' "></ExecutablePrefix>
        <ExecutablePrefix Condition=" '$(ExecutablePrefix)' == '' And '$(ClangTargetOS)' == 'windows'"></ExecutablePrefix>
        <ExecutablePrefix Condition=" '$(ExecutablePrefix)' == '' And '$(ClangTargetOS)' == 'unix'">lib</ExecutablePrefix>
        <ExecutablePrefix Condition=" '$(ExecutablePrefix)' == '' And '$(ClangTargetOS)' == 'apple'">lib</ExecutablePrefix>
        <ExecutablePrefix Condition=" '$(ExecutablePrefix)' == '' And '$(ClangTargetOS)' == 'wasm'">lib</ExecutablePrefix>
        <ExecutableExt Condition=" '$(ExecutableExt)' == '' "></ExecutableExt>
        <ExecutableExt Condition=" '$(ExecutableExt)' == '' And '$(ClangTargetOS)' == 'windows'">.dll</ExecutableExt>
        <ExecutableExt Condition=" '$(ExecutableExt)' == '' And '$(ClangTargetOS)' == 'unix'">.so</ExecutableExt>
        <ExecutableExt Condition=" '$(ExecutableExt)' == '' And '$(ClangTargetOS)' == 'apple'">.dylib</ExecutableExt>
        <ExecutableExt Condition=" '$(ExecutableExt)' == '' And '$(ClangTargetOS)' == 'wasm'">.so</ExecutableExt>
        <ExecutableFileName Condition=" '$(ExecutableFileName)' == '' ">$(ExecutablePrefix)$(TargetName)$(ExecutableExt)</ExecutableFileName>
        <ExecutableIntermediateOutputPath Condition=" '$(ExecutableFileName)' != '' ">$(IntermediateOutputPath)$(ExecutableFileName)</ExecutableIntermediateOutputPath>
        <LibraryPrefix Condition=" '$(LibraryPrefix)' == '' And '$(ClangTargetOS)' == 'unix' ">lib</LibraryPrefix>
        <LibraryPrefix Condition=" '$(LibraryPrefix)' == '' And '$(ClangTargetOS)' == 'apple' ">lib</LibraryPrefix>
        <LibraryPrefix Condition=" '$(LibraryPrefix)' == '' And '$(ClangTargetOS)' == 'wasm' ">lib</LibraryPrefix>
        <LibraryExt Condition=" '$(LibraryExt)' == '' And '$(ClangTargetOS)' == 'windows' ">.lib</LibraryExt>
        <LibraryExt Condition=" '$(LibraryExt)' == '' And '$(ClangTargetOS)' == 'unix' ">.so</LibraryExt>
        <LibraryExt Condition=" '$(LibraryExt)' == '' And '$(ClangTargetOS)' == 'apple' ">.dylib</LibraryExt>
        <LibraryExt Condition=" '$(LibraryExt)' == '' And '$(ClangTargetOS)' == 'wasm' ">.so</LibraryExt>
        <LibraryFileName Condition=" '$(LibraryFileName)' == '' ">$(LibraryPrefix)$(TargetName)$(LibraryExt)</LibraryFileName>
        <LibraryIntermediateOutputPath Condition=" '$(LibraryFileName)' != '' ">$(IntermediateOutputPath)$(LibraryFileName)</LibraryIntermediateOutputPath>
        <DebugSymbolsPrefix Condition=" '$(DebugSymbolsPrefix)' == '' And '$(ClangTargetOS)' == 'unix' ">lib</DebugSymbolsPrefix>
        <DebugSymbolsPrefix Condition=" '$(DebugSymbolsPrefix)' == '' And '$(ClangTargetOS)' == 'apple' ">lib</DebugSymbolsPrefix>
        <DebugSymbolsPrefix Condition=" '$(DebugSymbolsPrefix)' == '' And '$(ClangTargetOS)' == 'wasm' ">lib</DebugSymbolsPrefix>
        <CopyProjectReferenceOutputToOutput Condition=" '$(CopyProjectReferenceOutputToOutput)' == '' ">false</CopyProjectReferenceOutputToOutput>
        <UseLd Condition=" '$(UseLd)' == '' ">lld</UseLd>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(OutputType)' == 'lib' ">
        <ExecutablePrefix Condition=" '$(ExecutablePrefix)' == '' "></ExecutablePrefix>
        <ExecutableExt Condition=" '$(ExecutableExt)' == '' "></ExecutableExt>
        <ExecutableFileName Condition=" '$(ExecutableFileName)' == '' "></ExecutableFileName>
        <ExecutableIntermediateOutputPath Condition=" '$(ExecutableFileName)' != '' ">$(IntermediateOutputPath)$(ExecutableFileName)</ExecutableIntermediateOutputPath>
        <LibraryPrefix Condition=" '$(LibraryPrefix)' == '' And '$(ClangTargetOS)' == 'unix' ">lib</LibraryPrefix>
        <LibraryPrefix Condition=" '$(LibraryPrefix)' == '' And '$(ClangTargetOS)' == 'apple' ">lib</LibraryPrefix>
        <LibraryPrefix Condition=" '$(LibraryPrefix)' == '' And '$(ClangTargetOS)' == 'wasm' ">lib</LibraryPrefix>
        <LibraryExt Condition=" '$(LibraryExt)' == '' And '$(ClangTargetOS)' == 'windows' ">.lib</LibraryExt>
        <LibraryExt Condition=" '$(LibraryExt)' == '' And '$(ClangTargetOS)' == 'unix' ">.a</LibraryExt>
        <LibraryExt Condition=" '$(LibraryExt)' == '' And '$(ClangTargetOS)' == 'apple' ">.a</LibraryExt>
        <LibraryExt Condition=" '$(LibraryExt)' == '' And '$(ClangTargetOS)' == 'wasm' ">.a</LibraryExt>
        <LibraryFileName Condition=" '$(LibraryFileName)' == '' ">$(LibraryPrefix)$(TargetName)$(LibraryExt)</LibraryFileName>
        <LibraryIntermediateOutputPath Condition=" '$(LibraryFileName)' != '' ">$(IntermediateOutputPath)$(LibraryFileName)</LibraryIntermediateOutputPath>
        <DebugSymbolsPrefix Condition=" '$(DebugSymbolsPrefix)' == '' And '$(ClangTargetOS)' == 'unix' ">lib</DebugSymbolsPrefix>
        <DebugSymbolsPrefix Condition=" '$(DebugSymbolsPrefix)' == '' And '$(ClangTargetOS)' == 'apple' ">lib</DebugSymbolsPrefix>
        <DebugSymbolsPrefix Condition=" '$(DebugSymbolsPrefix)' == '' And '$(ClangTargetOS)' == 'wasm'">lib</DebugSymbolsPrefix>
        <CopyProjectReferenceOutputToOutput Condition=" '$(CopyProjectReferenceOutputToOutput)' == '' ">false</CopyProjectReferenceOutputToOutput>
    </PropertyGroup>

    <PropertyGroup>
        <ObjectExt Condition=" '$(ObjectExt)' == '' And '$(ClangTargetOS)' == 'windows' ">.obj</ObjectExt>
        <ObjectExt Condition=" '$(ObjectExt)' == '' ">.o</ObjectExt>
        <DebugSymbolsFileName Condition=" '$(DebugSymbolsFileName)' == '' And '$(DebugSymbolsExt)' != '' ">$(DebugSymbolsPrefix)$(TargetName)$(DebugSymbolsExt)</DebugSymbolsFileName>
        <DebugSymbolsIntermediateOutputPath Condition=" '$(DebugSymbolsFileName)' != '' ">$(IntermediateOutputPath)$(DebugSymbolsFileName)</DebugSymbolsIntermediateOutputPath>
        <HeadersPathName Condition=" '$(HeadersPathName)' == '' ">headers\</HeadersPathName>
        <HeadersIntermediateOutputPath Condition=" '$(HeadersPathName)' != '' ">$(IntermediateOutputPath)$(HeadersPathName)</HeadersIntermediateOutputPath>
    </PropertyGroup>

    <!--
    
    AssignProjectConfiguration
    
    Assigns the appropriate configuration to each project in the list of project references passed in.
    Adds to the project references passed in any project references implied by dependencies expressed in the solution file, if any.
    
    -->

    <Target Name="AssignProjectConfiguration" Condition="'$(CurrentSolutionConfigurationContents)' != '' Or '@(ProjectReference)'!=''">
        <PropertyGroup>
            <OnlyReferenceAndBuildProjectsEnabledInSolutionConfiguration Condition="'$(OnlyReferenceAndBuildProjectsEnabledInSolutionConfiguration)' == ''">true</OnlyReferenceAndBuildProjectsEnabledInSolutionConfiguration>
            <ShouldUnsetParentConfigurationAndPlatform Condition="'$(ShouldUnsetParentConfigurationAndPlatform)' == '' and ('$(BuildingInsideVisualStudio)' == 'true' or '$(BuildingSolutionFile)' == 'true')">true</ShouldUnsetParentConfigurationAndPlatform>
            <ShouldUnsetParentConfigurationAndPlatform Condition="'$(ShouldUnsetParentConfigurationAndPlatform)' == ''">false</ShouldUnsetParentConfigurationAndPlatform>
            <AddSyntheticProjectReferencesForSolutionDependencies Condition="'$(AddSyntheticProjectReferencesForSolutionDependencies)' == '' and '$(BuildingInsideVisualStudio)' != 'true'">true</AddSyntheticProjectReferencesForSolutionDependencies>
        </PropertyGroup>

        <AssignProjectConfiguration ProjectReferences="@(ProjectReference)" CurrentProject="$(MSBuildProjectFullPath)" CurrentProjectConfiguration="$(Configuration)" CurrentProjectPlatform="$(Platform)" DefaultToVcxPlatformMapping="$(DefaultToVcxPlatformMapping)" VcxToDefaultPlatformMapping="$(VcxToDefaultPlatformMapping)" OutputType="$(OutputType)" ResolveConfigurationPlatformUsingMappings="false" SolutionConfigurationContents="$(CurrentSolutionConfigurationContents)" AddSyntheticProjectReferencesForSolutionDependencies="$(AddSyntheticProjectReferencesForSolutionDependencies)" OnlyReferenceAndBuildProjectsEnabledInSolutionConfiguration="$(OnlyReferenceAndBuildProjectsEnabledInSolutionConfiguration)" ShouldUnsetParentConfigurationAndPlatform="$(ShouldUnsetParentConfigurationAndPlatform)">
            <Output TaskParameter="AssignedProjects" ItemName="ProjectReferenceWithConfiguration"/>
            <Output TaskParameter="UnassignedProjects" ItemName="ProjectReferenceWithConfiguration"/>
        </AssignProjectConfiguration>

        <ItemGroup>
            <ProjectReferenceWithConfiguration>
                <Targets Condition="'%(ProjectReferenceWithConfiguration.Targets)' == ''">Build</Targets>
                <BuildReference Condition="'%(ProjectReferenceWithConfiguration.BuildReference)' == ''">true</BuildReference>
                <ReferenceTargetItems Condition="'%(ProjectReferenceWithConfiguration.ReferenceTargetItems)' == ''">true</ReferenceTargetItems>
                <CopyTargetItemsLocal Condition="'%(ProjectReferenceWithConfiguration.CopyTargetItemsLocal)' == ''">true</CopyTargetItemsLocal>
            </ProjectReferenceWithConfiguration>
        </ItemGroup>
    </Target>

    <!--
    
    ResolveProjectReferences
    
    Ensure any project references are properly built.
    
    -->

    <ItemDefinitionGroup>
        <ProjectReference>
            <ReferenceSourceTarget>ProjectReference</ReferenceSourceTarget>
            <Include>True</Include>
            <Link>True</Link>
        </ProjectReference>
    </ItemDefinitionGroup>

    <PropertyGroup>
        <ResolveProjectReferencesDependsOn>
            $(ResolveProjectReferencesDependsOn);
            AssignProjectConfiguration;
            _AssignReferenceTargetIdentifiers;
        </ResolveProjectReferencesDependsOn>
    </PropertyGroup>

    <Target Name="ResolveProjectReferences" DependsOnTargets="$(ResolveProjectReferencesDependsOn)" Returns="@(_ResolvedNativeItemProjectReferences)">
        <MSBuild
            Projects="@(ProjectReferenceWithConfiguration)"
            Targets="%(ProjectReferenceWithConfiguration.Targets)"
            BuildInParallel="$(BuildInParallel)"
            Properties="%(ProjectReferenceWithConfiguration.SetConfiguration);%(ProjectReferenceWithConfiguration.SetPlatform);%(ProjectReferenceWithConfiguration.SetTargetIdentifier);"
            Condition=" '%(ProjectReferenceWithConfiguration.BuildReference)' == 'true' And '@(ProjectReferenceWithConfiguration)' != '' And ('$(BuildingInsideVisualStudio)' == 'true' Or '$(BuildProjectReferences)' != 'true') And '$(VisualStudioVersion)' != '10.0' and '@(ProjectReferenceWithConfiguration)' != ''"
            ContinueOnError="false"
            RemoveProperties="%(ProjectReferenceWithConfiguration.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences)"
            RebaseOutputs="true">
        </MSBuild>
    </Target>

    <!--

    _AssignReferenceTargetIdentifiers

    Passes this project's target identifier to each reference explicitly (see AssignReferenceTargetIdentifier), and
    asks each referenced project which target identifiers it builds, to report a reference with several that a project
    building for the host cannot choose between.

    -->

    <Target Name="_AssignReferenceTargetIdentifiers" DependsOnTargets="AssignProjectConfiguration" Condition=" '@(ProjectReferenceWithConfiguration)' != '' ">
        <MSBuild
            Projects="@(ProjectReferenceWithConfiguration)"
            Targets="GetTargetIdentifiers"
            SkipNonexistentTargets="true"
            BuildInParallel="$(BuildInParallel)"
            Properties="%(ProjectReferenceWithConfiguration.SetConfiguration);%(ProjectReferenceWithConfiguration.SetPlatform)"
            RemoveProperties="TargetIdentifier;%(ProjectReferenceWithConfiguration.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences)">
            <Output TaskParameter="TargetOutputs" ItemName="_ReferenceTargetIdentifiers" />
        </MSBuild>

        <AssignReferenceTargetIdentifier References="@(ProjectReferenceWithConfiguration)" Reports="@(_ReferenceTargetIdentifiers)" TargetIdentifier="$(TargetIdentifier)">
            <Output TaskParameter="AssignedReferences" ItemName="_ProjectReferenceWithTargetIdentifier" />
        </AssignReferenceTargetIdentifier>

        <ItemGroup>
            <ProjectReferenceWithConfiguration Remove="@(ProjectReferenceWithConfiguration)" />
            <ProjectReferenceWithConfiguration Include="@(_ProjectReferenceWithTargetIdentifier)" />
        </ItemGroup>
    </Target>

    <!--

    GetTargetIdentifiers

    Externally callable target that reports what this project builds: for a project with a single target, its
    TargetIdentifier. (The cross-targeting build reports TargetIdentifiers instead.)

    -->

    <Target Name="GetTargetIdentifiers" Returns="@(_TargetIdentifiersReport)">
        <ItemGroup>
            <_TargetIdentifiersReport Include="$(MSBuildProjectFullPath)">
                <TargetIdentifiers></TargetIdentifiers>
                <TargetIdentifier>$(TargetIdentifier)</TargetIdentifier>
            </_TargetIdentifiersReport>
        </ItemGroup>
    </Target>

    <Target Name="ResolveProjectReferencesDesignTime">

    </Target>

    <!--
    
    GetOutputItem
    
    Externally callable target that returns information about the native target being built.
    
    -->

    <Target Name="GetOutputItem" Returns="@(GetOutputItem)">
        <ItemGroup>
            <GetOutputItem Include="$([System.IO.Path]::GetFullPath('$(MSBuildProjectFile)'))">
                <TargetIdentifier>$(TargetIdentifier)</TargetIdentifier>
                <TargetName>$(TargetName)</TargetName>
                <TargetTriple>$(TargetTriple)</TargetTriple>
                <ExecutablePath Condition=" '$(ExecutableIntermediateOutputPath)' != '' ">$([System.IO.Path]::GetFullPath('$(ExecutableIntermediateOutputPath)'))</ExecutablePath>
                <LibraryPath Condition=" '$(LibraryIntermediateOutputPath)' != '' ">$([System.IO.Path]::GetFullPath('$(LibraryIntermediateOutputPath)'))</LibraryPath>
                <DebugSymbolsPath Condition=" '$(DebugSymbolsIntermediateOutputPath)' != '' ">$([System.IO.Path]::GetFullPath('$(DebugSymbolsIntermediateOutputPath)'))</DebugSymbolsPath>
                <HeadersPath Condition=" '$(HeadersIntermediateOutputPath)' != '' ">$([System.IO.Path]::GetFullPath('$(HeadersIntermediateOutputPath)'))</HeadersPath>
                <Version>$(Version)</Version>
                <CopyUpToDateMarker>@(CopyUpToDateMarker)</CopyUpToDateMarker>
            </GetOutputItem>
        </ItemGroup>
    </Target>

    <!--
    
    GetProjectReferenceOutputItems
    
    Externally callable target that returns information about the native target being built and the same for any dependent project references.
    
    -->

    <Target Name="GetProjectReferenceOutputItems" DependsOnTargets="AssignProjectConfiguration;_AssignReferenceTargetIdentifiers" Returns="@(GetProjectReferenceOutputItems)">
        <MSBuild
            Projects="@(ProjectReferenceWithConfiguration)"
            Targets="GetOutputItem"
            SkipNonexistentTargets="true"
            BuildInParallel="$(BuildInParallel)"
            Properties="%(ProjectReferenceWithConfiguration.SetConfiguration);%(ProjectReferenceWithConfiguration.SetPlatform);%(ProjectReferenceWithConfiguration.SetTargetIdentifier);"
            Condition="'%(ProjectReferenceWithConfiguration.BuildReference)' == 'true' And '@(ProjectReferenceWithConfiguration)' != '' And ('$(BuildingInsideVisualStudio)' == 'true' Or '$(BuildProjectReferences)' != 'true') And '$(VisualStudioVersion)' != '10.0' And '@(ProjectReferenceWithConfiguration)' != ''"
            ContinueOnError="false"
            RemoveProperties="%(ProjectReferenceWithConfiguration.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences)"
            RebaseOutputs="false">
            <Output TaskParameter="TargetOutputs" ItemName="_GetProjectReferenceOutputItems" Condition=" '%(ProjectReferenceWithConfiguration.ReferenceTargetItems)' == 'true' "/>
        </MSBuild>
        <RemoveDuplicates Inputs="@(_GetProjectReferenceOutputItems)">
            <Output TaskParameter="Filtered" ItemName="__GetProjectReferenceOutputItems"/>
        </RemoveDuplicates>
        <ItemGroup>
            <GetProjectReferenceOutputItems Include="@(__GetProjectReferenceOutputItems)" />
        </ItemGroup>
    </Target>

    <!--
    
    ImportProjectReferenceItems
    
    Collect any items resolved from ProjectReferences and configure locally.
    
    -->
    <PropertyGroup>
        <ImportProjectReferenceItemsDependsOn>
            $(ImportProjectReferenceItemsDependsOn);
            AssignProjectConfiguration;
            GetProjectReferenceOutputItems;
        </ImportProjectReferenceItemsDependsOn>
    </PropertyGroup>

    <Target Name="ImportProjectReferenceItems" DependsOnTargets="$(ImportProjectReferenceItemsDependsOn)">
        <ItemGroup>
            <IncludeDirectories Include="@(GetProjectReferenceOutputItems->WithMetadataValue('Include', 'True')->'%(HeadersPath)')" />
            <_LibraryDirectories Remove="@(_LibraryDirectories)" />
            <_LibraryDirectories Include="@(GetProjectReferenceOutputItems->WithMetadataValue('Link', 'True')->'%(LibraryPath)')" />
            <LibraryDirectories Include="@(_LibraryDirectories->'%(RootDir)%(Directory)')" />
            <Dependencies Include="@(GetProjectReferenceOutputItems->WithMetadataValue('Link', 'True')->'%(TargetName)')" />
        </ItemGroup>
    </Target>

    <UsingTask TaskName="IkvmClangSdkGenerateUniqueFileName" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <MetadataName ParameterType="System.String" Required="true" />
            <Extension ParameterType="System.String" Required="true" />
            <Directory ParameterType="System.String" />
            <Items ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" Output="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.Collections.Generic" />
            <Using Namespace="System.IO" />
            <Code Language="cs" Type="Fragment">
                <![CDATA[
                var hs = new HashSet<string>();
                
                foreach (var item in Items)
                {
                    var i = 0;
                    var n = item.GetMetadata("FileName") ?? Path.ChangeExtension(Path.GetRandomFileName(), "");
                    var s = n;
                    while (hs.Add(s) == false)
                        s = n + "_" + (++i);
                    
                    item.SetMetadata(MetadataName, Path.Combine(Directory ?? "", s + Extension ?? item.GetMetadata("Extension")));
                }
            ]]>
            </Code>
        </Task>
    </UsingTask>

    <!--
    
    PrepareCompile
    
    Generates the ObjectPath metadata for each input Compile item by selecting a unique identifying name.
    
    -->

    <Target Name="PrepareCompile" DependsOnTargets="ImportProjectReferenceItems" Condition=" '@(Compile)' != '' ">
        <IkvmClangSdkGenerateUniqueFileName Items="@(Compile)" MetadataName="ObjectPath" Extension="$(ObjectExt)" Directory="$(IntermediateOutputPath)">
            <Output TaskParameter="Items" ItemName="_Compile" />
        </IkvmClangSdkGenerateUniqueFileName>

        <ItemGroup>
            <Compile Remove="@(Compile)" />
            <Compile Include="@(_Compile)" />
        </ItemGroup>
    </Target>

    <!--
    
    ResolveLlvmToolset
    
    Finds the LLVM tools (see the properties at the top of this file). Sets ClangPath, ClangCxxPath, LlvmArPath and
    ClangdPath to the tools found, or to nothing for those not found; LlvmToolsDirectory to clang's directory;
    ClangResourceDirectory to where clang's builtin headers are; and LlvmToolsetProblem items, with Code and Message
    metadata, for the tools that could not be found. Targets that run a tool check for it with the _CheckLlvmTool
    targets; design-time builds only report the problems, through GetLlvmToolset.
    
    -->

    <Target Name="ResolveLlvmToolset">
        <ResolveLlvmToolset
            LlvmToolsPath="$(LlvmToolsPath)"
            ClangPath="$(ClangPath)"
            ClangCxxPath="$(ClangCxxPath)"
            LlvmArPath="$(LlvmArPath)"
            ClangdPath="$(ClangdPath)"
            LinkerPath="$(LinkerPath)"
            ClangFileName="$([System.IO.Path]::GetFileName('$(ClangToolExe)'))"
            ClangCxxFileName="$(ClangCxxToolName)"
            LlvmArFileName="$([System.IO.Path]::GetFileName('$(LlvmArToolExe)'))"
            ClangdFileName="$(ClangdToolName)"
            VsInstallRoot="$(VsInstallRoot)">
            <Output TaskParameter="ClangPath" PropertyName="ClangPath" />
            <Output TaskParameter="ClangCxxPath" PropertyName="ClangCxxPath" />
            <Output TaskParameter="LlvmArPath" PropertyName="LlvmArPath" />
            <Output TaskParameter="ClangdPath" PropertyName="ClangdPath" />
            <Output TaskParameter="LinkerPath" PropertyName="LinkerPath" />
            <Output TaskParameter="LlvmToolsDirectory" PropertyName="LlvmToolsDirectory" />
            <Output TaskParameter="ClangResourceDirectory" PropertyName="ClangResourceDirectory" />
            <Output TaskParameter="ProblemsJson" PropertyName="LlvmToolsetProblemsJson" />
            <Output TaskParameter="Problems" ItemName="LlvmToolsetProblem" />
        </ResolveLlvmToolset>

        <PropertyGroup>
            <!-- compile commands name clang even when it was not found, so tools such as clangd can still use them -->
            <_ClangCommandCompiler>$(ClangPath)</_ClangCommandCompiler>
            <_ClangCommandCompiler Condition=" '$(_ClangCommandCompiler)' == '' ">$(ClangToolExe)</_ClangCommandCompiler>
        </PropertyGroup>
    </Target>

    <!--
    The checks run before a tool is used: each fails the build with the reason the tool is missing and how to correct
    it. Design-time builds never run them.
    -->
    <Target Name="_CheckClang" DependsOnTargets="ResolveLlvmToolset">
        <Error Condition=" '$(ClangPath)' == '' " Code="@(LlvmToolsetProblem->WithMetadataValue('Identity', 'Clang')->'%(Code)')" Text="@(LlvmToolsetProblem->WithMetadataValue('Identity', 'Clang')->'%(Message)')" />
    </Target>

    <Target Name="_CheckLlvmAr" DependsOnTargets="ResolveLlvmToolset">
        <Error Condition=" '$(LlvmArPath)' == '' " Code="@(LlvmToolsetProblem->WithMetadataValue('Identity', 'LlvmAr')->'%(Code)')" Text="@(LlvmToolsetProblem->WithMetadataValue('Identity', 'LlvmAr')->'%(Message)') llvm-ar creates static libraries." />
    </Target>

    <Target Name="_CheckLinker" DependsOnTargets="ResolveLlvmToolset">
        <Error Condition=" '@(LlvmToolsetProblem->WithMetadataValue('Identity', 'Linker'))' != '' " Code="@(LlvmToolsetProblem->WithMetadataValue('Identity', 'Linker')->'%(Code)')" Text="@(LlvmToolsetProblem->WithMetadataValue('Identity', 'Linker')->'%(Message)')" />
    </Target>

    <!--
    
    GetLlvmToolset
    
    Externally callable target that returns the resolved LLVM tools as one item, named by the project, with ClangPath,
    ClangCxxPath, LlvmArPath, ClangdPath, LinkerPath, LlvmToolsDirectory and ClangResourceDirectory metadata, and
    Problems: a JSON array of the tools that could not be found, each with tool, code and message. Design-time builds
    run it for the Visual Studio extension, which takes clangd from it and shows the problems.
    
    -->

    <Target Name="GetLlvmToolset" DependsOnTargets="ResolveLlvmToolset" Returns="@(LlvmToolset)">
        <ItemGroup>
            <LlvmToolset Remove="@(LlvmToolset)" />
            <LlvmToolset Include="$(MSBuildProjectFullPath)">
                <TargetIdentifier>$(TargetIdentifier)</TargetIdentifier>
                <ClangPath>$(ClangPath)</ClangPath>
                <ClangCxxPath>$(ClangCxxPath)</ClangCxxPath>
                <LlvmArPath>$(LlvmArPath)</LlvmArPath>
                <ClangdPath>$(ClangdPath)</ClangdPath>
                <LinkerPath>$(LinkerPath)</LinkerPath>
                <LlvmToolsDirectory>$(LlvmToolsDirectory)</LlvmToolsDirectory>
                <ClangResourceDirectory>$(ClangResourceDirectory)</ClangResourceDirectory>
                <Problems>$(LlvmToolsetProblemsJson)</Problems>
            </LlvmToolset>
        </ItemGroup>
    </Target>


    <!--
    
    ComputeClangCompileCommands
    
    Works out the clang command line for each Compile item without compiling anything. CoreCompile runs these
    commands, and GetClangCompileCommands returns them to tools such as the Visual Studio extension, which hands them
    to clangd. Design-time builds call it, so it must not build: project references are only asked for their output
    items.
    
    -->

    <PropertyGroup>
        <ComputeClangCompileCommandsDependsOn>
            $(ComputeClangCompileCommandsDependsOn);
            ResolveLlvmToolset;
            ImportProjectReferenceItems;
            PrepareCompile;
        </ComputeClangCompileCommandsDependsOn>
    </PropertyGroup>

    <Target Name="ComputeClangCompileCommands" DependsOnTargets="$(ComputeClangCompileCommandsDependsOn);_ComputeClangCompileCommand" />

    <Target Name="_ComputeClangCompileCommand" Outputs="%(Compile.Identity)" Condition=" '@(Compile)' != '' ">
        <PropertyGroup>
            <_SourcePath>%(Compile.Identity)</_SourcePath>
            <_ObjectPath>%(Compile.ObjectPath)</_ObjectPath>
            <_DebugSymbols>%(Compile.DebugSymbols)</_DebugSymbols>
            <_DebugSymbols Condition=" '$(_DebugSymbols)' == '' ">$(DebugSymbols)</_DebugSymbols>
            <_Language>%(Compile.Language)</_Language>
            <_Language Condition=" '$(_Language)' == '' ">$(Language)</_Language>
            <!-- C -->
            <_Language Condition=" '$(_Language)' == '' And '%(Compile.Extension)' == '.c' ">c</_Language>
            <!-- C++ -->
            <_Language Condition=" '$(_Language)' == '' And '%(Compile.Extension)' == '.cpp' ">c++</_Language>
            <_Language Condition=" '$(_Language)' == '' And '%(Compile.Extension)' == '.cc' ">c++</_Language>
            <_Language Condition=" '$(_Language)' == '' And '%(Compile.Extension)' == '.cxx' ">c++</_Language>
            <_Language Condition=" '$(_Language)' == '' And '%(Compile.Extension)' == '.c++' ">c++</_Language>
            <_Language Condition=" '$(_Language)' == '' And '%(Compile.Extension)' == '.cppm' ">c++</_Language>
            <_Language Condition=" '$(_Language)' == '' And '%(Compile.Extension)' == '.ixx' ">c++</_Language>
            <!-- Objective-C -->
            <_Language Condition=" '$(_Language)' == '' And '%(Compile.Extension)' == '.m' ">objective-c</_Language>
            <!-- Objective-C++ -->
            <_Language Condition=" '$(_Language)' == '' And '%(Compile.Extension)' == '.mm' ">objective-c++</_Language>
            <!-- Assembly (passed through clang as assembler-with-cpp) -->
            <_Language Condition=" '$(_Language)' == '' And '%(Compile.Extension)' == '.s' ">assembler-with-cpp</_Language>
            <_Language Condition=" '$(_Language)' == '' And '%(Compile.Extension)' == '.S' ">assembler-with-cpp</_Language>
            <_Language Condition=" '$(_Language)' == '' And '%(Compile.Extension)' == '.asm' ">assembler-with-cpp</_Language>
            <_LanguageStandard>%(Compile.LanguageStandard)</_LanguageStandard>
            <_LanguageStandard Condition=" '$(_LanguageStandard)' == '' ">$(LanguageStandard)</_LanguageStandard>
            <_Optimization>%(Compile.Optimization)</_Optimization>
            <_Optimization Condition=" '$(_Optimization)' == '' ">$(Optimization)</_Optimization>
            <_PositionIndependentCode>%(Compile.PositionIndependentCode)</_PositionIndependentCode>
            <_PositionIndependentCode Condition=" '$(_PositionIndependentCode)' == '' ">$(PositionIndependentCode)</_PositionIndependentCode>
            <_MsCompatibility>%(Compile.MsCompatibility)</_MsCompatibility>
            <_MsCompatibility Condition=" '$(_MsCompatibility)' == '' ">$(MsCompatibility)</_MsCompatibility>
            <_MsCompatibilityVersion>%(Compile.MsCompatibilityVersion)</_MsCompatibilityVersion>
            <_MsCompatibilityVersion Condition=" '$(_MsCompatibilityVersion)' == '' ">$(MsCompatibilityVersion)</_MsCompatibilityVersion>
        </PropertyGroup>

        <ItemGroup>
            <_Args Remove="@(_Args)" />
            <_Args Include="-c" />
            <_Args Include="-v" Condition=" '$(Verbose)' == 'true' " />
            <_Args Include="--target" Value="$(TargetTriple)" Separator="=" Condition=" '$(TargetTriple)' != '' " />
            <_Args Include="-g" Condition=" '$(_DebugSymbols)' == 'true' " />
            <_Args Include="-O$(_Optimization)" Condition=" '$(_Optimization)' != '' " />

            <_Args Include="-std" Value="$(_LanguageStandard)" Separator="=" Condition=" '$(_LanguageStandard)' != '' " />
            <_Args Include="-fPIC" Condition=" '$(_PositionIndependentCode)' == 'true' " />
            <_Args Include="-fms-compatibility" Condition=" '$(_MsCompatibility)' == 'true' " />
            <_Args Include="-fms-compatibility-version" Value="$(_MsCompatibilityVersion)" Separator="=" Condition=" '$(_MsCompatibilityVersion)' != '' " />

            <_Args Include="-x;$(_Language)" Condition=" '$(_Language)' != '' " />

            <_SystemRootDirectories Remove="@(_SystemRootDirectories)" />
            <_SystemRootDirectories Include="@(SystemRootDirectories)" />
            <_SystemRootDirectories Include="$(SystemRootDirectories)" />
            <_SystemRootDirectories Include="%(Compile.SystemRootDirectories)" />
            <_SystemRootDirectoriesTemp Remove="@(_SystemRootDirectoriesTemp)" />
            <_SystemRootDirectoriesTemp Include="@(_SystemRootDirectories->Distinct())" />
            <_SystemRootDirectoriesArgs Remove="@(_SystemRootDirectoriesArgs)" />
            <_SystemRootDirectoriesArgs Include="@(_SystemRootDirectoriesTemp->'--sysroot')" Value="%(_SystemRootDirectoriesTemp.Identity)" Separator=" " />
            <_Args Include="@(_SystemRootDirectoriesArgs)" />

            <_IncludeSystemRootDirectories Remove="@(_IncludeSystemRootDirectories)" />
            <_IncludeSystemRootDirectories Include="@(IncludeSystemRootDirectories)" />
            <_IncludeSystemRootDirectories Include="$(IncludeSystemRootDirectories)" />
            <_IncludeSystemRootDirectories Include="%(Compile.IncludeSystemRootDirectories)" />
            <_IncludeSystemRootDirectoriesTemp Remove="@(_IncludeSystemRootDirectoriesTemp)" />
            <_IncludeSystemRootDirectoriesTemp Include="@(_IncludeSystemRootDirectories->Distinct())" />
            <_IncludeSystemRootDirectoriesArgs Remove="@(_IncludeSystemRootDirectoriesArgs)" />
            <_IncludeSystemRootDirectoriesArgs Include="@(_IncludeSystemRootDirectoriesTemp->'-isysroot')" Value="%(_IncludeSystemRootDirectoriesTemp.Identity)" Separator=" " />
            <_Args Include="@(_IncludeSystemRootDirectoriesArgs)" />

            <_SystemIncludeDirectories Remove="@(_SystemIncludeDirectories)" />
            <_SystemIncludeDirectories Include="@(SystemIncludeDirectories)" />
            <_SystemIncludeDirectories Include="$(SystemIncludeDirectories)" />
            <_SystemIncludeDirectories Include="%(Compile.SystemIncludeDirectories)" />
            <_SystemIncludeDirectoriesTemp Remove="@(_SystemIncludeDirectoriesTemp)" />
            <_SystemIncludeDirectoriesTemp Include="@(_SystemIncludeDirectories->Distinct())" />
            <_SystemIncludeDirectoriesArgs Remove="@(_SystemIncludeDirectoriesArgs)" />
            <_SystemIncludeDirectoriesArgs Include="@(_SystemIncludeDirectoriesTemp->'-isystem')" Value="%(_SystemIncludeDirectoriesTemp.Identity)" Separator=" " />
            <_Args Include="@(_SystemIncludeDirectoriesArgs)" />

            <_IncludeDirectories Remove="@(_IncludeDirectories)" />
            <_IncludeDirectories Include="@(IncludeDirectories)" />
            <_IncludeDirectories Include="$(IncludeDirectories)" />
            <_IncludeDirectories Include="%(Compile.IncludeDirectories)" />
            <_IncludeDirectoriesTemp Remove="@(_IncludeDirectoriesTemp)" />
            <_IncludeDirectoriesTemp Include="@(_IncludeDirectories->Distinct())" />
            <_IncludeDirectoriesArgs Remove="@(_IncludeDirectoriesArgs)" />
            <_IncludeDirectoriesArgs Include="@(_IncludeDirectoriesTemp->'-I')" Value="%(_IncludeDirectoriesTemp.Identity)" Separator="" />
            <_Args Include="@(_IncludeDirectoriesArgs)" />

            <_PreprocessorDefinitions Remove="@(_PreprocessorDefinitions)" />
            <_PreprocessorDefinitions Include="NDEBUG" Condition=" '$(Assertions)' == 'false' " />
            <_PreprocessorDefinitions Include="@(PreprocessorDefinitions)" />
            <_PreprocessorDefinitions Include="$(PreprocessorDefinitions)" />
            <_PreprocessorDefinitions Include="%(Compile.PreprocessorDefinitions)" />
            <_PreprocessorDefinitionsArgs Remove="@(_PreprocessorDefinitionsArgs)" />
            <_PreprocessorDefinitionsArgs Include="@(_PreprocessorDefinitions->'-D')" Value="%(_PreprocessorDefinitions.Identity)" Separator="" Value2="%(_PreprocessorDefinitions.Value)" Separator2="=" />
            <_Args Include="@(_PreprocessorDefinitionsArgs)" />

            <_AdditionalOptions Remove="@(_AdditionalOptions)" />
            <_AdditionalOptions Include="@(AdditionalCompileOptions)" />
            <_AdditionalOptions Include="$(AdditionalCompileOptions)" />
            <_AdditionalOptions Include="%(Compile.AdditionalCompileOptions)" />
            <_Args Include="@(_AdditionalOptions)" />

            <_Args Include="$(_SourcePath)" />

            <_Args Include="-o" Value="$(_ObjectPath)" Separator=" " />
        </ItemGroup>

        <ClangCompileCommand Source="$(_SourcePath)" Directory="$(MSBuildProjectDirectory)" Compiler="$(_ClangCommandCompiler)" Arguments="@(_Args)">
            <Output TaskParameter="Command" ItemName="_ClangCompileCommand" />
            <Output TaskParameter="ArgumentList" ItemName="_ClangCompileArgument" />
        </ClangCompileCommand>

        <ItemGroup>
            <ClangCompileCommand Include="@(_ClangCompileCommand)">
                <ObjectPath>$(_ObjectPath)</ObjectPath>
                <TargetIdentifier>$(TargetIdentifier)</TargetIdentifier>
                <ArgumentList>@(_ClangCompileArgument)</ArgumentList>
                <ResourceDirectory>$(ClangResourceDirectory)</ResourceDirectory>
                <Language>$(_Language)</Language>
            </ClangCompileCommand>
            <_ClangCompileCommand Remove="@(_ClangCompileCommand)" />
            <_ClangCompileArgument Remove="@(_ClangCompileArgument)" />
        </ItemGroup>
    </Target>

    <!--
    
    GetClangCompileCommands
    
    Externally callable target that returns the compile command of each source file, with CommandLine (a JSON array
    of the compiler and its arguments), WorkingDirectory, TargetIdentifier and ResourceDirectory (where the
    compiler's builtin headers are) metadata.
    
    -->

    <Target Name="GetClangCompileCommands" DependsOnTargets="ComputeClangCompileCommands" Returns="@(ClangCompileCommand)" />

    <!--
    
    CoreCompile
    
    Invokes the Clang compiler for each Compile item to generate the output object file.
    
    -->

    <PropertyGroup>
        <CoreCompileDependsOn>
            $(CoreCompileDependsOn);
            ResolveProjectReferences;
            ComputeClangCompileCommands;
            _CheckClang;
        </CoreCompileDependsOn>
    </PropertyGroup>

    <!--
    Compiles the sources that are out of date, ClangMaxParallelism at a time (by default one per processor). A source is
    out of date when its object is missing or older than it or any file it includes, as clang listed them when it was
    last compiled, or when its command line changed.
    -->
    <Target Name="CoreCompile" DependsOnTargets="$(CoreCompileDependsOn)">
        <ClangCompile Condition=" '@(ClangCompileCommand)' != '' " Commands="@(ClangCompileCommand)" Compiler="$(ClangPath)" MaxParallelism="$(ClangMaxParallelism)" EnvironmentVariables="@(LlvmEnvironmentVariables)">
            <Output TaskParameter="FileWrites" ItemName="FileWrites" />
            <Output TaskParameter="Compiled" PropertyName="_ClangCompiled" />
        </ClangCompile>

        <CallTarget Targets="$(TargetsTriggeredByCompilation)" Condition=" '$(TargetsTriggeredByCompilation)' != '' And '$(_ClangCompiled)' == 'true' " />
    </Target>

    <!--
    
    CoreLink
    
    Invokes the Clang compiler for the set of all object files to produce the final taraget, library and debug symbols.
    
    -->

    <PropertyGroup>
        <CoreLinkDependsOn>
            $(CoreLinkDependsOn);
            ResolveLlvmToolset;
            Compile;
            ImportProjectReferenceItems;
        </CoreLinkDependsOn>
    </PropertyGroup>

    <!--
    Picks the driver that links: clang++ when any source is C++ or Objective-C++, so that the C++ standard library is
    linked, otherwise clang. Set LinkWithClangCxx to true or false to choose.
    -->
    <Target Name="_PrepareLinkDriver" DependsOnTargets="ResolveLlvmToolset;ComputeClangCompileCommands;_CheckLinker">
        <ItemGroup>
            <_ClangCxxSource Remove="@(_ClangCxxSource)" />
            <_ClangCxxSource Include="@(ClangCompileCommand)" Condition=" '%(ClangCompileCommand.Language)' == 'c++' Or '%(ClangCompileCommand.Language)' == 'objective-c++' " />
        </ItemGroup>

        <PropertyGroup>
            <_ClangLinkWithCxx>$(LinkWithClangCxx)</_ClangLinkWithCxx>
            <_ClangLinkWithCxx Condition=" '$(_ClangLinkWithCxx)' == '' And '@(_ClangCxxSource)' != '' ">true</_ClangLinkWithCxx>
            <_ClangLinkDriver Condition=" '$(_ClangLinkWithCxx)' == 'true' ">$(ClangCxxPath)</_ClangLinkDriver>
            <_ClangLinkDriver Condition=" '$(_ClangLinkWithCxx)' != 'true' ">$(ClangPath)</_ClangLinkDriver>
        </PropertyGroup>

        <Error Condition=" '$(_ClangLinkWithCxx)' == 'true' And '$(ClangCxxPath)' == '' " Code="@(LlvmToolsetProblem->WithMetadataValue('Identity', 'ClangCxx')->'%(Code)')" Text="@(LlvmToolsetProblem->WithMetadataValue('Identity', 'ClangCxx')->'%(Message)') clang++ links projects with C++ or Objective-C++ sources; set LinkWithClangCxx to false to link with clang instead." />
        <Error Condition=" '$(_ClangLinkWithCxx)' != 'true' And '$(ClangPath)' == '' " Code="@(LlvmToolsetProblem->WithMetadataValue('Identity', 'Clang')->'%(Code)')" Text="@(LlvmToolsetProblem->WithMetadataValue('Identity', 'Clang')->'%(Message)')" />
    </Target>

    <!--
    Works out the link command, and records it in a file whose time changes only when the command does, so that the
    link reruns when any option changes; and collects the libraries of referenced projects, so that it reruns when one
    of those is rebuilt.
    -->
    <Target Name="_ComputeClangLinkArguments" DependsOnTargets="$(CoreLinkDependsOn);_PrepareLinkDriver" Condition=" '$(OutputType)' == 'exe' Or '$(OutputType)' == 'dll' ">
        <ItemGroup>
            <_ClangLinkArgs Remove="@(_ClangLinkArgs)" />
            <_ClangLinkArgs Include="-shared" Condition=" '$(OutputType)' == 'dll' " />
            <_ClangLinkArgs Include="-v" Condition=" '$(Verbose)' == 'true' " />
            <_ClangLinkArgs Include="--target" Value="$(TargetTriple)" Separator="=" Condition=" '$(TargetTriple)' != '' " />
            <_ClangLinkArgs Include="-fuse-ld" Value="$(UseLd)" Separator="=" Condition=" '$(UseLd)' != '' " />
            <_ClangLinkArgs Include="--ld-path" Value="$(LinkerPath)" Separator="=" Condition=" '$(LinkerPath)' != '' " />
            <_ClangLinkArgs Include="-g" Condition=" '$(DebugSymbols)' == 'true' " />

            <_ClangLinkArgs Include="-Wl,/subsystem:$(Subsystem)" Condition=" '$(Subsystem)' != '' And '$(ClangTargetIsMsvc)' == 'true' " />

            <_SystemRootDirectories Remove="@(_SystemRootDirectories)" />
            <_SystemRootDirectories Include="@(SystemRootDirectories)" />
            <_SystemRootDirectories Include="$(SystemRootDirectories)" />
            <_SystemRootDirectoriesTemp Remove="@(_SystemRootDirectoriesTemp)" />
            <_SystemRootDirectoriesTemp Include="@(_SystemRootDirectories->Distinct())" />
            <_SystemRootDirectoriesArgs Remove="@(_SystemRootDirectoriesArgs)" />
            <_SystemRootDirectoriesArgs Include="@(_SystemRootDirectoriesTemp->'--sysroot')" Value="%(_SystemRootDirectoriesTemp.Identity)" Separator=" " />
            <_ClangLinkArgs Include="@(_SystemRootDirectoriesArgs)" />

            <_IncludeSystemRootDirectories Remove="@(_IncludeSystemRootDirectories)" />
            <_IncludeSystemRootDirectories Include="@(IncludeSystemRootDirectories)" />
            <_IncludeSystemRootDirectories Include="$(IncludeSystemRootDirectories)" />
            <_IncludeSystemRootDirectoriesTemp Remove="@(_IncludeSystemRootDirectoriesTemp)" />
            <_IncludeSystemRootDirectoriesTemp Include="@(_IncludeSystemRootDirectories->Distinct())" />
            <_IncludeSystemRootDirectoriesArgs Remove="@(_IncludeSystemRootDirectoriesArgs)" />
            <_IncludeSystemRootDirectoriesArgs Include="@(_IncludeSystemRootDirectoriesTemp->'-isysroot')" Value="%(_IncludeSystemRootDirectoriesTemp.Identity)" Separator=" " />
            <_ClangLinkArgs Include="@(_IncludeSystemRootDirectoriesArgs)" />

            <_LibraryDirectories Remove="@(_LibraryDirectories)" />
            <_LibraryDirectories Include="@(LibraryDirectories)" />
            <_LibraryDirectories Include="$(LibraryDirectories)" />
            <_LibraryDirectoriesTemp Remove="@(_LibraryDirectoriesTemp)" />
            <_LibraryDirectoriesTemp Include="@(_LibraryDirectories->Distinct())" />
            <_LibraryDirectoriesArgs Remove="@(_LibraryDirectoriesArgs)" />
            <_LibraryDirectoriesArgs Include="@(_LibraryDirectoriesTemp->'-L')" Value="%(_LibraryDirectoriesTemp.Identity)" Separator="" />
            <_ClangLinkArgs Include="@(_LibraryDirectoriesArgs)" />

            <_Dependencies Remove="@(_Dependencies)" />
            <_Dependencies Include="@(Dependencies)" />
            <_Dependencies Include="$(Dependencies)" />
            <_DependenciesTemp Remove="@(_DependenciesTemp)" />
            <_DependenciesTemp Include="@(_Dependencies->Distinct())" />
            <_DependenciesArgs Remove="@(_DependenciesArgs)" />
            <_DependenciesArgs Include="@(_DependenciesTemp->'-l')" Value="%(_DependenciesTemp.Identity)" Separator="" />
            <_ClangLinkArgs Include="@(_DependenciesArgs)" />

            <_AdditionalOptions Remove="@(_AdditionalOptions)" />
            <_AdditionalOptions Include="@(AdditionalLinkOptions)" />
            <_AdditionalOptions Include="$(AdditionalLinkOptions)" />
            <_ClangLinkArgs Include="@(_AdditionalOptions)" />

            <_ClangLinkArgs Include="@(Compile->'%(ObjectPath)')" />

            <_ClangLinkArgs Include="-o" Value="$(ExecutableIntermediateOutputPath)" Separator=" " />
        </ItemGroup>

        <ItemGroup>
            <_ClangLinkLibraryInputs Remove="@(_ClangLinkLibraryInputs)" />
            <_ClangLinkLibraryInputs Include="@(GetProjectReferenceOutputItems->WithMetadataValue('Link', 'True')->'%(LibraryPath)')" Condition=" '%(GetProjectReferenceOutputItems.LibraryPath)' != '' " />
        </ItemGroup>

        <PropertyGroup>
            <_ClangLinkCommandFile>$(IntermediateOutputPath)$(TargetName).link.cmd</_ClangLinkCommandFile>
        </PropertyGroup>

        <ClangCompileCommand Source="$(ExecutableIntermediateOutputPath)" Directory="$(MSBuildProjectDirectory)" Compiler="$(_ClangLinkDriver)" Arguments="@(_ClangLinkArgs)">
            <Output TaskParameter="Command" ItemName="_ClangLinkCommand" />
        </ClangCompileCommand>

        <MakeDir Directories="$(IntermediateOutputPath)" />
        <WriteLinesToFile File="$(_ClangLinkCommandFile)" Lines="@(_ClangLinkCommand->'%(CommandLine)')" Overwrite="true" WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <FileWrites Include="$(_ClangLinkCommandFile)" />
        </ItemGroup>
    </Target>

    <Target Name="CoreLinkExecutable" DependsOnTargets="_ComputeClangLinkArguments" Inputs="@(Compile->'%(ObjectPath)');@(_ClangLinkLibraryInputs);$(_ClangLinkCommandFile)" Outputs="$(ExecutableIntermediateOutputPath);$(LibraryIntermediateOutputPath)" Condition=" '$(OutputType)' == 'exe' Or '$(OutputType)' == 'dll' ">
        <ClangExe ToolExe="$(_ClangLinkDriver)" Arguments="@(_ClangLinkArgs)" EnvironmentVariables="@(LlvmEnvironmentVariables)" />

        <ItemGroup>
            <FileWrites Include="$(ExecutableIntermediateOutputPath)" />
            <FileWrites Include="$(LibraryIntermediateOutputPath)" />
            <FileWrites Include="$(DebugSymbolsIntermediateOutputPath)" Condition=" '$(DebugSymbolsIntermediateOutputPath)' != '' " />
        </ItemGroup>

        <CallTarget Targets="$(TargetsTriggeredByLinking)" Condition="'$(TargetsTriggeredByLinking)' != ''" />
    </Target>

    <!--
    Works out the archive command and records it, as for linking, so that adding or removing a source re-creates the
    archive.
    -->
    <Target Name="_ComputeClangArchiveArguments" DependsOnTargets="$(CoreLinkDependsOn);_CheckLlvmAr" Condition=" '$(OutputType)' == 'lib' ">
        <ItemGroup>
            <_ClangArchiveArgs Remove="@(_ClangArchiveArgs)" />
            <!-- c: create the archive without llvm-ar reporting it, which the build would show as a warning -->
            <_ClangArchiveArgs Include="rc" />
            <_ClangArchiveArgs Include="$(LibraryIntermediateOutputPath)" />
            <_ClangArchiveArgs Include="@(Compile->'%(ObjectPath)')" />
            <_ClangArchiveArgs Include="@(AdditionalArchiveOptions)" />
            <_ClangArchiveArgs Include="$(AdditionalArchiveOptions)" />
        </ItemGroup>

        <PropertyGroup>
            <_ClangArchiveCommandFile>$(IntermediateOutputPath)$(TargetName).ar.cmd</_ClangArchiveCommandFile>
        </PropertyGroup>

        <ClangCompileCommand Source="$(LibraryIntermediateOutputPath)" Directory="$(MSBuildProjectDirectory)" Compiler="$(LlvmArPath)" Arguments="@(_ClangArchiveArgs)">
            <Output TaskParameter="Command" ItemName="_ClangArchiveCommand" />
        </ClangCompileCommand>

        <MakeDir Directories="$(IntermediateOutputPath)" />
        <WriteLinesToFile File="$(_ClangArchiveCommandFile)" Lines="@(_ClangArchiveCommand->'%(CommandLine)')" Overwrite="true" WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <FileWrites Include="$(_ClangArchiveCommandFile)" />
        </ItemGroup>
    </Target>

    <Target Name="CoreLinkLibrary" DependsOnTargets="_ComputeClangArchiveArguments" Inputs="@(Compile->'%(ObjectPath)');$(_ClangArchiveCommandFile)" Outputs="$(LibraryIntermediateOutputPath)" Condition=" '$(OutputType)' == 'lib' ">
        <!-- llvm-ar adds to an existing archive, which would keep the objects of removed sources -->
        <Delete Files="$(LibraryIntermediateOutputPath)" />

        <LlvmArExe ToolExe="$(LlvmArPath)" Arguments="@(_ClangArchiveArgs)" EnvironmentVariables="@(LlvmEnvironmentVariables)" />

        <ItemGroup>
            <FileWrites Include="$(LibraryIntermediateOutputPath)" />
        </ItemGroup>

        <CallTarget Targets="$(TargetsTriggeredByLinking)" Condition="'$(TargetsTriggeredByLinking)' != ''" />
    </Target>

    <Target Name="CoreLink" DependsOnTargets="CoreLinkExecutable;CoreLinkLibrary">
        
    </Target>
    
    <!--
    
    CopyHeaders
    
    Collect any headers and copy to temp directory.
    
    -->

    <Target Name="PrepareCopyHeaders">
        <ItemGroup>
            <Header Update="@(Header)">
                <IncludePath Condition=" '%(Header.IncludePath)' == '' ">%(RecursiveDir)%(Filename)%(Extension)</IncludePath>
            </Header>
            <_HeaderToCopy Remove="@(_HeaderToCopy)" />
            <_HeaderToCopy Include="@(Header)" Condition=" '%(Header.CopyToIncludeDirectory)' == 'true' " />
        </ItemGroup>
    </Target>

    <PropertyGroup>
        <CopyHeadersDependsOn>
            $(CopyHeadersDependsOn);
            PrepareCopyHeaders;
        </CopyHeadersDependsOn>
    </PropertyGroup>

    <Target Name="CopyHeaders" DependsOnTargets="$(CopyHeadersDependsOn)" Inputs="@(_HeaderToCopy)" Outputs="@(_HeaderToCopy->'$(HeadersIntermediateOutputPath)%(IncludePath)')">
        <Copy
            SourceFiles="@(_HeaderToCopy)"
            DestinationFiles="@(_HeaderToCopy->'$(HeadersIntermediateOutputPath)%(IncludePath)')"
            SkipUnchangedFiles="$(SkipCopyUnchangedFiles)"
            OverwriteReadOnlyFiles="$(OverwriteReadOnlyFiles)"
            Retries="$(CopyRetryCount)"
            RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)"
            UseHardlinksIfPossible="$(CreateHardLinksForCopyFilesToOutputDirectoryIfPossible)"
            UseSymboliclinksIfPossible="$(CreateSymbolicLinksForCopyFilesToOutputDirectoryIfPossible)"
            ErrorIfLinkFails="$(ErrorIfLinkFailsForCopyFilesToOutputDirectory)">
            <Output TaskParameter="DestinationFiles" ItemName="FileWrites"/>
        </Copy>
    </Target>

    <!--
    
    GetCopyToOutputDirectoryItems
    
    Collect any items that need to be copied to the output target directory (bin/lib/include).
    
    -->

    <PropertyGroup>
        <GetCopyToOutputDirectoryItemsDependsOn>
            $(GetCopyToOutputDirectoryItemsDependsOn);
            GetProjectReferenceOutputItems;
        </GetCopyToOutputDirectoryItemsDependsOn>
    </PropertyGroup>

    <!--

    GetSharedLibraryOutputItems

    Externally callable target that returns the shared libraries a program using this project needs at run time: this
    project's own, if it is one, and those of its references, all the way down. Each has a TargetPath.

    -->

    <Target Name="GetSharedLibraryOutputItems" DependsOnTargets="AssignProjectConfiguration;_AssignReferenceTargetIdentifiers" Returns="@(SharedLibraryOutputItems)">
        <MSBuild
            Projects="@(ProjectReferenceWithConfiguration)"
            Targets="GetSharedLibraryOutputItems"
            SkipNonexistentTargets="true"
            BuildInParallel="$(BuildInParallel)"
            Properties="%(ProjectReferenceWithConfiguration.SetConfiguration);%(ProjectReferenceWithConfiguration.SetPlatform);%(ProjectReferenceWithConfiguration.SetTargetIdentifier);"
            RemoveProperties="%(ProjectReferenceWithConfiguration.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences)"
            Condition=" '@(ProjectReferenceWithConfiguration)' != '' ">
            <Output TaskParameter="TargetOutputs" ItemName="SharedLibraryOutputItems" />
        </MSBuild>

        <ItemGroup Condition=" '$(OutputType)' == 'dll' ">
            <SharedLibraryOutputItems Include="$([System.IO.Path]::GetFullPath('$(ExecutableIntermediateOutputPath)'))" Condition=" Exists('$(ExecutableIntermediateOutputPath)') ">
                <TargetPath>$(ExecutableFileName)</TargetPath>
            </SharedLibraryOutputItems>
            <SharedLibraryOutputItems Include="$([System.IO.Path]::GetFullPath('$(DebugSymbolsIntermediateOutputPath)'))" Condition=" '$(DebugSymbolsIntermediateOutputPath)' != '' And Exists('$(DebugSymbolsIntermediateOutputPath)') ">
                <TargetPath>$(DebugSymbolsFileName)</TargetPath>
            </SharedLibraryOutputItems>
        </ItemGroup>
    </Target>

    <!-- the shared libraries of references, for an executable to find next to it when it runs -->
    <Target Name="_GetReferencedSharedLibraries" DependsOnTargets="AssignProjectConfiguration;_AssignReferenceTargetIdentifiers" Condition=" '$(CopyProjectReferenceOutputToOutput)' == 'true' And '@(ProjectReferenceWithConfiguration)' != '' ">
        <MSBuild
            Projects="@(ProjectReferenceWithConfiguration)"
            Targets="GetSharedLibraryOutputItems"
            SkipNonexistentTargets="true"
            BuildInParallel="$(BuildInParallel)"
            Properties="%(ProjectReferenceWithConfiguration.SetConfiguration);%(ProjectReferenceWithConfiguration.SetPlatform);%(ProjectReferenceWithConfiguration.SetTargetIdentifier);"
            RemoveProperties="%(ProjectReferenceWithConfiguration.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences)">
            <Output TaskParameter="TargetOutputs" ItemName="_ReferencedSharedLibraries" />
        </MSBuild>
    </Target>

    <Target Name="GetCopyToOutputDirectoryItems" DependsOnTargets="$(GetCopyToOutputDirectoryItemsDependsOn);_GetReferencedSharedLibraries" Returns="@(OutputItemsWithTargetPath)">
        <Error Condition=" '$(ExecutableIntermediateOutputPath)' == '$(DebugSymbolsIntermediateOutputPath)' And Exists('$(ExecutableIntermediateOutputPath)') And Exists('$(DebugSymbolsIntermediateOutputPath)')" Text="Output file name and debug file name are equal." />
        <ItemGroup>
            <OutputItemsWithTargetPath Include="$(ExecutableIntermediateOutputPath)" Condition=" '$(ExecutableIntermediateOutputPath)' != '' And Exists('$(ExecutableIntermediateOutputPath)')">
                <TargetPath>$(ExecutableFileName)</TargetPath>
            </OutputItemsWithTargetPath>
            <OutputItemsWithTargetPath Include="$(DebugSymbolsIntermediateOutputPath)" Condition=" '$(DebugSymbolsIntermediateOutputPath)' != '' And Exists('$(DebugSymbolsIntermediateOutputPath)')">
                <TargetPath>$(DebugSymbolsFileName)</TargetPath>
            </OutputItemsWithTargetPath>
            <OutputItemsWithTargetPath Include="@(_ReferencedSharedLibraries->Distinct())" />
        </ItemGroup>
    </Target>

    <PropertyGroup>
        <CoreBuildDependsOn>
            AssignProjectConfiguration;
            Compile;
            Link;
            CopyHeaders;
            CopyFilesToOutputDirectory;
        </CoreBuildDependsOn>
    </PropertyGroup>

    <Target Name="CoreBuild" DependsOnTargets="$(CoreBuildDependsOn)" />

    <!--

    CoreClean

    Adds the files the build produces to the Clean items: the object files, the linked or archived output and its
    debug symbols, the copied headers, and the copies in the output directory. Clean also deletes everything earlier
    builds recorded writing; these cover outputs that were never recorded.

    -->

    <PropertyGroup>
        <CoreCleanDependsOn>
            $(CoreCleanDependsOn);
            _AddClangOutputsToClean;
        </CoreCleanDependsOn>
    </PropertyGroup>

    <Target Name="_AddClangOutputsToClean" DependsOnTargets="PrepareCompile;PrepareCopyHeaders">
        <ItemGroup>
            <Clean Include="@(Compile->'%(ObjectPath)')" />
            <Clean Include="$(ExecutableIntermediateOutputPath)" Condition=" '$(ExecutableIntermediateOutputPath)' != '' " />
            <Clean Include="$(LibraryIntermediateOutputPath)" Condition=" '$(LibraryIntermediateOutputPath)' != '' " />
            <Clean Include="$(DebugSymbolsIntermediateOutputPath)" Condition=" '$(DebugSymbolsIntermediateOutputPath)' != '' " />
            <Clean Include="@(_HeaderToCopy->'$(HeadersIntermediateOutputPath)%(IncludePath)')" Condition=" '$(HeadersIntermediateOutputPath)' != '' " />
            <Clean Include="@(Compile->'%(ObjectPath).d');@(Compile->'%(ObjectPath).cmd')" />
            <Clean Include="$(IntermediateOutputPath)$(TargetName).link.cmd;$(IntermediateOutputPath)$(TargetName).ar.cmd" />
            <Clean Include="$(OutputPath)$(ExecutableFileName)" Condition=" '$(ExecutableFileName)' != '' " />
            <Clean Include="$(OutputPath)$(DebugSymbolsFileName)" Condition=" '$(DebugSymbolsFileName)' != '' " />
        </ItemGroup>
    </Target>

    <Target Name="CoreClean" DependsOnTargets="$(CoreCleanDependsOn)" />

</Project>
